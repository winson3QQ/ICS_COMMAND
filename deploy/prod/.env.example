# deploy/prod/.env.example — 複製成 .env（已 gitignored）後填值。
# 「相同佈署、不同 delivery」：同一份 compose，差異全在這檔。
#
# 產隨機密鑰：openssl rand -hex 24

# ── ICS 核心（必填）──────────────────────────────────────────────
# step-ca provisioner 密碼（blast radius 最大，務必隨機）
STEP_CA_PASSWORD=
# nginx ↔ 後端共享密鑰（#280，防內網偽造 cert header）
ICS_PROXY_SHARED_SECRET=
# client p12 匯入密碼（issue-client 發裝置憑證時用）
ICS_CLIENT_P12_PASS=
# nginx server 憑證 SAN：寫進「現場實際連的對外位址」（空白分隔多個）
#   ⚠ 嚴格 client 會驗 → 一定要含你的公網 IP / 網域
#   ⚠ #321 L9：公網部署「只放公網可達名稱」（公網 IP / DNS），勿放 RFC1918 內網 IP
#     （10/8、172.16/12、192.168/16）—— SAN 任何 TLS client 握手即可讀，會洩內網拓樸。
#     ca-bootstrap 預設過濾內網 IP；內網存取走 split-DNS / 公網 hairpin。
ICS_SERVER_SANS=1.34.230.218
# 純 LAN/dev 確需把內網 IP 寫進 server cert（明知洩拓樸）才設 true；公網部署勿開。
#ICS_SERVER_SANS_ALLOW_PRIVATE=false
# mTLS 強制（bootstrap 綁定階段可先 false，綁好改 true）
ICS_MTLS_REQUIRED=true
# #343 紅藍 faction 隔離濾鏡：on 時 commander 以下只見 blue+neutral（紅軍/未分類 fail-closed 藏）、sysadmin 全見。
# 演習要紅藍隔離才設 true（預設 off，零風險漸進啟用）。需配合 admin「紅藍分類」指派 + TAK group 現場隔離(#344)。
#ICS_FACTION_ISOLATION=true
# 憑證效期（server + client）。#279：step-ca-claims-wrap 已把 provisioner claims reproducible 放寬
# 90 天（fresh deploy 自動，免手動 patch），compose 預設即 2160h（90 天）。要改短/長解註下面：
#STEP_CLIENT_CERT_DURATION=2160h
#ICS_SERVER_CERT_DURATION=2160h
# CA provisioner 上限（claims）由 step-ca-claims-wrap 設，預設 90 天；要全改別的解註：
#ICS_CA_MAX_CERT_DURATION=2160h

# ── TAK delivery toggle ──────────────────────────────────────────
# 純 ICS delivery：TAK_ENABLED=false 且「不要」加 --profile tak（TAK 容器不存在）。
# ICS+TAK delivery：TAK_ENABLED=true + 啟動帶 --profile tak。
TAK_ENABLED=false

# ── 以下僅在 TAK_ENABLED=true 時需要 ────────────────────────────
# 內網位址（容器名；不要用公網 IP）
TAK_COT_URL=tls://takserver:8089
TAK_MARTI_URL=https://takserver:8443
# #315 TAK 裝置證 data package 的 connectString = 對外可達 TAK 位址（公網/LAN IP，非容器名）
# 空 → admin TAK tab 發裝置證回 503。port 預設 8089。
TAK_DEVICE_CONNECT_HOST=
#TAK_DEVICE_CONNECT_PORT=8089
# ICS→TAK 憑證（step-ca 簽，放 ./tak-certs/，由 ../tak-server/pki/issue-tak-certs.sh 產）
# 路徑為「容器內」路徑（./tak-certs 掛成 /tak-certs）
TAK_CLIENT_CERT=/tak-certs/ics-cot.fullchain.pem
TAK_CLIENT_KEY=/tak-certs/ics-cot.key
TAK_CAFILE=/tak-certs/step-ca-root.pem
TAK_MARTI_READ_CERT=/tak-certs/ics-marti-read.fullchain.pem
TAK_MARTI_READ_KEY=/tak-certs/ics-marti-read.key
TAK_MARTI_WRITE_CERT=/tak-certs/ics-marti-write.fullchain.pem
TAK_MARTI_WRITE_KEY=/tak-certs/ics-marti-write.key
# #344/#357：管理級 cert（ROLE_ADMIN，certmod -A 標記）→ user-management group API（faction 分類同步 TAK group）。
# read/write cert 打 user-management 回 403，故需獨立 admin cert。空 → faction 分類純 ICS 視圖層、不同步現場群。
TAK_MARTI_ADMIN_CERT=/tak-certs/ics-tak-admin.fullchain.pem
TAK_MARTI_ADMIN_KEY=/tak-certs/ics-tak-admin.key
# #344 enrollment：發證即把裝置證 fingerprint 註冊成 TAK managed user + 初始群（經 tak-registrar 跑 usermod）。
# 沒這步裝置落匿名 __ANON__，faction 分類（PR #363 REST update-groups）改不動它。queue dir = 與 registrar 共享卷
# 掛載點（compose 已掛 /registrar-queue）。空 → 不註冊（裝置落匿名、待 roster 補；#343 視圖層仍運作）。
TAK_ENROLL_QUEUE_DIR=/registrar-queue
TAK_ENROLL_DEFAULT_GROUP=neutral          # 初始群（fail-closed：未分類即與紅藍互不可見）
TAK_ENROLL_TIMEOUT_S=8                     # 等 registrar 結果逾時（best-effort，逾時跳過不擋發證）
TAK_ENROLL_URL=https://takserver:8446       # #429 ICS 代理 enrollment（dashboard signClient 發證）；空=回退 #315 offline 簽
# 對外轉發的 TAK port（admin 8443 預設不對外，見 compose 註解）
TAK_STREAMING_PORT=8089
TAK_CERTENROLL_PORT=8446

# 註：TAK server「自身」設定（DB 密碼等）在 ../tak-server/.env（見 deploy/tak-server/README），
#     與本檔分離——本檔只管 ICS 端 + 整合 + delivery toggle。
