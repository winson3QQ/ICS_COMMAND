# ics-validation/.env.example — mTLS 驗證棧必設機密（#290 H6）
#
# 用法：複製成 .env（已 gitignored），填入隨機值後再 `docker compose -f docker-compose.mtls.yml up`。
# compose 對這些變數用 ${VAR:?} —— 未設即報錯（fail-closed），不再有公開預設密碼。
#
# 產隨機值（任一）：
#   openssl rand -hex 24
#   head -c 24 /dev/urandom | base64 | tr -dc 'A-Za-z0-9' | head -c 32

# CA provisioner 密碼（blast radius 最大：能簽任意 CN 憑證繞 mTLS，務必隨機）
STEP_CA_PASSWORD=

# nginx ↔ 後端共享密鑰（#280：證明 X-Client-Cert-* 真來自 nginx，防內網偽造）
ICS_PROXY_SHARED_SECRET=

# client p12 匯入密碼（issue-client 產裝置憑證時用）
ICS_CLIENT_P12_PASS=

# ── 選用 ───────────────────────────────────────────────────────────
# 外網驗證：公網 IP/網域寫進 server 憑證 SAN（空白分隔多個）
# ICS_SERVER_SANS=1.34.230.218
# bootstrap 綁定階段可先設 false，綁好再 true
# ICS_MTLS_REQUIRED=true
# issue-client 產證時的裝置 CN
# CERT_CN=commander-phone-01
