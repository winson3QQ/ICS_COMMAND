# .env.example — TAK Server 部署參數範本（ICS_Command P2-01 / issue #99）
# 用法：cp .env.example .env，改下列值。.env 已 gitignored（含密碼，勿入版控）。

# ── 版本（對齊解壓的 release 目錄）──────────────────────────────────────────
TAK_RELEASE=5.7-RELEASE-43

# ── 對外 port（host 端；容器內固定 8089/8443/8446）────────────────────────
TAK_STREAMING_PORT=8089      # CoT TLS streaming ← ICS_Command tak_service 連這裡
TAK_WEBUI_PORT=8443          # web UI / REST
TAK_CERTENROLL_PORT=8446     # 憑證註冊

# ── 憑證（step-ca 簽，見 pki/issue-tak-certs.sh）────────────────────────
# TAK Server 對外呈現的主機名（step-ca 簽憑證的 CN/SAN；ICS_Command 連線時驗這個）
TAK_HOSTNAME=tak.ics.local
# JKS keystore 密碼。官方 default 'atakatak'（CoreConfig 寫死）；正式部署務必改，
# 並同步改 release/tak/CoreConfig.xml 內 keystorePass/truststorePass。
TAK_KEYSTORE_PASS=atakatak

# ── JVM heap（MB）。留空 → 容器依 RAM 自動算（API/MESSAGING=RAM/6300 較大）。
# dev 機 RAM 有限（如 M1 16GB 給 Docker ~10GB）建議手動壓低，避免 OOM：
CONFIG_MAX_HEAP=512
MESSAGING_MAX_HEAP=1024
API_MAX_HEAP=1024
PLUGIN_MANAGER_MAX_HEAP=256
RETENTION_MAX_HEAP=256

# ── PostgreSQL（CoreConfig 寫死 db=cot / user=martiuser；密碼在 CoreConfig 設）──
# 註：TAK 的 DB 密碼實際由 release/tak/CoreConfig.xml 的 <connection password="..."> 控制，
# 非由此 env 注入（保留此處僅作文件提示）。改密碼請改 CoreConfig.xml。
POSTGRES_DB=cot
POSTGRES_USER=martiuser
