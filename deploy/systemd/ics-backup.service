[Unit]
Description=ICS_Command Encrypted Backup Service (沿襲 ICS_DMAS #41 DR Drill 設計)
Documentation=https://github.com/winson3QQ/ICS_DMAS/issues/41
After=ics-command.service
# Wants= 不是 Requires=：backup 該比 app 更可靠，app 出問題時更需要 backup（不應被綁住）
Wants=ics-command.service

[Service]
Type=oneshot
User=__INSTALL_USER__
Group=__INSTALL_USER__
# WorkingDirectory 不依賴 repo 路徑（避免 ProtectHome 衝突 / repo 位置改變影響）
WorkingDirectory=/

# E-3 frozen: BACKUP_ENCRYPTION_KEY env var 必須由 EnvironmentFile 提供
# deploy/setup.sh 產生 /etc/ics-backup.env (chmod 0600, 含 BACKUP_ENCRYPTION_KEY=...)
EnvironmentFile=/etc/ics-backup.env
# 對齊 ics-command.service 的 ICS_DB_PATH=/var/lib/ics/ics.db（FHS production path）
Environment=ICS_DB_PATH=/var/lib/ics/ics.db

# B-1: --encrypt default true (對齊 #41 production policy)
# 7 day retention (B-5 Sync v2)
# backup 落 /var/lib/ics/backups（與 DB 同 FHS 位置，獨立於 repo）
ExecStart=/usr/bin/python3 __REPO_ROOT__/command-dashboard/scripts/backup_db.py \
    --backup-dir /var/lib/ics/backups \
    --retain-days 7 \
    --encrypt

# Hardening (對齊 systemd security best practice)
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
# DB + backups 都在 /var/lib/ics
ReadWritePaths=/var/lib/ics
# ProtectHome=read-only 讓 backup_db.py（位於 repo 內，可能在 /home）仍可讀，但無法寫
ProtectHome=read-only
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictNamespaces=true
LockPersonality=true
RestrictRealtime=true

[Install]
WantedBy=multi-user.target
