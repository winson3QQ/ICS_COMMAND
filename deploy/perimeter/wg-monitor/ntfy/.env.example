# deploy/perimeter/wg-monitor/ntfy/.env.example — 複製成 .env（.env 不進 git）

# ntfy 對外 base URL（手機/瀏覽器看到的位址）。經 WG 則填 wg0 端位址；LAN 則填主機 IP。
NTFY_BASE_URL=http://localhost:8080

# 手機訂閱用的對外埠
NTFY_PORT=8080

# 要 join 的 prod icsnet 實名（docker network ls | grep icsnet 查；多半 ics-prod_icsnet）
ICS_NET=ics-prod_icsnet

# 訊息保留（鎖屏漏接補得回）
NTFY_CACHE_DURATION=168h

# 存取預設（deny-all = 只有開的帳號能讀寫；演示可改 read-write 開放）
NTFY_AUTH_DEFAULT_ACCESS=deny-all
