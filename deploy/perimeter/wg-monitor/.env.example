# deploy/perimeter/wg-monitor/.env.example — 複製成 .env 後填寫（.env 不進 git）
#
# ics-wg 容器名（預設 ics-wg）。若 ics-prod 的 ics-wg 服務未設 container_name，
# 改填產生名（如 ics-prod-ics-wg-1），或在該服務加一行 container_name: ics-wg。
WGMON_WG_CONTAINER=ics-wg

# WG 介面與輪詢
WGMON_IFACE=wg0
WGMON_POLL_S=20

# 投遞：自架 ntfy 的完整 topic URL（空=只落 log 不推播）。
# ⚠ 此 URL 是 egress，須在 #450 egress 白名單內。
WGMON_NTFY_URL=
WGMON_NTFY_TOKEN=

# 偵測門檻（可留空用預設；見 src/config.py / README）
# WGMON_OSC_WINDOW_S=180
# WGMON_OFFLINE_AFTER_S=180
# WGMON_DORMANT_AFTER_S=86400
# WGMON_COOLDOWN_S=600
