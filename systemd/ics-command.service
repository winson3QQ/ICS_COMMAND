[Unit]
Description=ICS_Command 指揮部後端 (FastAPI :8000)
After=network-online.target
Wants=network-online.target
# systemd 240+ 起，StartLimitIntervalSec / StartLimitBurst 屬 [Unit] 區段
# 放在 [Service] 會產生 deprecation warning（journalctl 可見）
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
User=ics
Group=ics
WorkingDirectory=/home/ics/ics-command/command-dashboard
# --workers 1 必須保留：COP 即時推播是 in-process broadcaster（issue #29 PR-D，
# services/realtime_hub.py）。多 worker 下各自獨立 hub → WS 廣播跨 worker 漏幀。
# 水平擴張需改 Redis pub/sub（Wave 7 federation），屆時才可拿掉此 pin。
ExecStart=/home/ics/ics-command/command-dashboard/.venv/bin/uvicorn main:app --app-dir src --host 0.0.0.0 --port 8000 --workers 1

# Defaults 先設，再讓 EnvironmentFile 覆寫（systemd: 後者覆寫前者）
# Site-specific 設定走 EnvironmentFile（前綴 `-` 表示檔案不存在不 fail）
# drop-in 進階覆寫見 ics-command.service.d/README.md
Environment=ICS_DB_PATH=/var/lib/ics/ics.db
Environment=ICS_LOG_DIR=/var/log/ics
EnvironmentFile=-/etc/ics/command.env

StandardOutput=append:/var/log/ics/command.log
StandardError=append:/var/log/ics/command.log
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
