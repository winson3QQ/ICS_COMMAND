[Unit]
Description=ICS_Command 指揮部後端 (FastAPI :8000)
After=network-online.target
Wants=network-online.target
# systemd 240+ 起，StartLimitIntervalSec / StartLimitBurst 屬 [Unit] 區段
# 放在 [Service] 會產生 deprecation warning（journalctl 可見）
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
User=ics
Group=ics
WorkingDirectory=/home/ics/ics-command/command-dashboard
# --workers 1 必須保留：COP 即時推播是 in-process broadcaster（issue #29 PR-D，
# services/realtime_hub.py）。多 worker 下各自獨立 hub → WS 廣播跨 worker 漏幀。
# 水平擴張需改 Redis pub/sub（Wave 7 federation），屆時才可拿掉此 pin。
# #275 wave 2（紅線「後端只經 nginx 可達」）：bind loopback，不對外網直曝 :8000。
# 否則攻擊者直連後端可繞過 nginx 的 mTLS + X-Client-Cert-* 剝除（偽造 AAL2 第二因子）。
# bare-metal 部署 nginx 與 uvicorn 同主機，127.0.0.1 即可達；容器部署另走 compose
# 不 publish 後端埠（deploy/ics-validation，Dockerfile 內仍 0.0.0.0 供同網路 nginx 連）。
ExecStart=/home/ics/ics-command/command-dashboard/.venv/bin/uvicorn main:app --app-dir src --host 127.0.0.1 --port 8000 --workers 1

# Defaults 先設，再讓 EnvironmentFile 覆寫（systemd: 後者覆寫前者）
# Site-specific 設定走 EnvironmentFile（前綴 `-` 表示檔案不存在不 fail）
# drop-in 進階覆寫見 ics-command.service.d/README.md
Environment=ICS_DB_PATH=/var/lib/ics/ics.db
Environment=ICS_LOG_DIR=/var/log/ics
EnvironmentFile=-/etc/ics/command.env
# P1-12a (#227) keymgmt：unlock_key.py 解 FIDO2 後寫入的 child keys
# （BACKUP_KEY / DB_KEY）。manned C2 流程（threat_model §8.4）：開機後
# operator 跑 `python scripts/keymgmt/unlock_key.py --store /etc/ics/master-key.enc
# --output /run/ics/keys.env` 再 start 本服務。`-` 前綴：檔不存在不 fail
# （未 enroll 的部署走舊 env / fallback，P1-12b 起消費）。
EnvironmentFile=-/run/ics/keys.env

StandardOutput=append:/var/log/ics/command.log
StandardError=append:/var/log/ics/command.log
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
